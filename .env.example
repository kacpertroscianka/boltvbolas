# Configure these values privately in your hosting provider or local .env file.
# Do NOT commit real values. Do NOT expose CANDY_SESSION_SECRET to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CANDY_PASSWORD_HASH=
CANDY_SESSION_SECRET=

# Server-side secret MUST match app_config(key=candy_session_secret) in Supabase.
# Never expose either in a public ZIP or repository.

# Optional Phase 12 server-only Captain Mode. Generate with: node scripts/generate-captain-hash.cjs
# Never set NEXT_PUBLIC_ for this value. Do not use the shared Candy password.
CAPTAIN_PASSWORD_HASH=
# Independent captain passwords (hashes only). Use the generator for each team.
CAPTAIN_PASSWORD_HASH_EVERLAST=
CAPTAIN_PASSWORD_HASH_TERRORY=
